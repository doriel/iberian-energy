title: Two Jobs, two kinds of trigger, and what is left to a person
config:
  flowchart:
    wrappingWidth: 400
    rankSpacing: 60
    nodeSpacing: 30
    padding: 12
---
flowchart TB
  subgraph job["iberian-daily · six tasks, on a clock, because the market is on a clock"]
    direction TB
    cron(["<b>iberian-daily</b><br/>16:00 Europe/Lisbon, after the day-ahead results<br/>max_concurrent_runs 1 · failure email only"])
    ingest["<b>ingest</b><br/>01_build_medallion<br/>lands three trailing days in the Volume<br/>same Volume 01f backfills into<br/>2 retries, 5 min apart"]
    notices["<b>load_notices</b><br/>01b_load_notices<br/>A78 notices, vector index sync<br/>2 retries, off the path to publish"]
    transform["<b>transform</b><br/>Lakeflow declarative pipeline<br/>bronze, silver, gold<br/>never full_refresh on a schedule"]
    explain["<b>explain</b><br/>02_explain_episodes<br/>max_new 25 · notice_retrieval direct<br/>0 retries, a partial run already wrote"]
    publish["<b>publish</b><br/>03_publish_dashboard<br/>commits data.json to the repo<br/>1 retry, reads the sha first"]
    sync["<b>sync_lakebase</b><br/>04_sync_episodes_to_lakebase<br/>upsert into iberian.episodes<br/>after publish, so the dashboard never waits on a database"]

    cron --> ingest
    ingest --> notices
    ingest --> transform
    transform --> explain
    explain --> publish
    publish --> sync
  end

  subgraph activity["iberian-activity · one task, on data, because usage is not on a clock"]
    direction TB
    people(["<b>somebody uses the workbench</b><br/>labels an episode · saves an alert · asks the agent"])
    pg["<b>Lakebase</b><br/>alerts · episode_labels · agent_actions"]
    cdf["<b>change data feed</b><br/>off the write ahead log<br/>flushed about every 15s"]
    trig(["<b>table update trigger</b><br/>ANY_UPDATED over the three lb_*_history tables<br/>120s quiet period · 300s floor between runs"])
    build["<b>application_activity</b><br/>01g_build_application_activity<br/>watermark per source, keyed MERGE<br/>2 retries, safe because the merge is keyed"]

    people --> pg
    pg --> cdf
    cdf --> trig
    trig --> build
  end

  subgraph manual["Run by hand · genuinely occasional, and nothing downstream waits on them"]
    direction TB
    setup["<b>00</b> notice index · <b>00b</b> Lakebase schema<br/><b>00c</b> service principal grants · <b>00d</b> change data feed<br/>run once, idempotent"]
    gen["<b>01c</b> ingest generation · <b>01d</b> silver per unit<br/><b>01e</b> gold_unit_hourly_output<br/>a year of history, not a daily derivation"]
    backfill["<b>01f_backfill_market_history</b><br/>chunked and resumable, you say how many days"]
    evaluate["<b>99_evaluate_retrieval</b><br/>direct against vector, and the leak measured<br/>a measurement, run when it is worth measuring"]

    setup ~~~ gen
    backfill ~~~ evaluate
  end

