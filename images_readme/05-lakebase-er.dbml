// The Lakebase application schema, iberian.
//
// Paste this into https://dbdiagram.io (free, no account needed to edit) if you
// want to move the boxes around or export a different layout. The authoritative
// version is sql/001_application_tables.sql; this file is a drawing of it, so
// if the two disagree the SQL is right.
//
// Every table here carries REPLICA IDENTITY FULL. Without it the Lakebase
// change data feed carries only the primary key on an update, and the analytics
// pipeline cannot see what changed.

Project iberian {
  database_type: 'PostgreSQL'
  Note: 'Lakebase application tables. episodes is written by the daily Job; the other three are written by the app and the agent.'
}

Table iberian.episodes {
  episode_key          text           [pk, note: 'market_day + start time, content derived, so a backfill does not orphan labels']
  market_day           date           [not null]
  start_utc            timestamptz    [not null]
  end_utc              timestamptz    [not null, note: 'CHECK end_utc > start_utc']
  premium_side         text           [not null, note: 'CHECK in (PT, ES)']
  peak_abs_spread      "numeric(10,2)" [not null, note: 'CHECK >= 0']
  severity             text           [not null, note: 'CHECK in (minor, moderate, severe)']
  extra_cost_eur       "numeric(14,2)" [note: 'import direction only, not the same as congestion rent']
  min_capacity_mw      "numeric(10,2)"
  capacity_percentile  "numeric(5,1)"  [note: 'CHECK 0..100. Below 25 the border was carrying unusually little']
  share_saturated      "numeric(4,3)"  [note: 'CHECK 0..1']
  updated_at           timestamptz    [not null, default: `now()`]

  Indexes {
    market_day [name: 'episodes_market_day_idx', note: 'DESC']
    (severity, peak_abs_spread) [name: 'episodes_severity_idx']
  }

  Note: 'Copied from gold_split_episodes by 04_sync_episodes_to_lakebase. Owned rather than synced, because episode_labels has a foreign key to it and a synced table is managed by Databricks.'
}

Table iberian.alerts {
  id                 bigserial       [pk]
  created_by         text            [not null, note: 'CHECK length(trim()) > 0']
  zone               text            [not null, note: 'CHECK in (PT, ES)']
  direction          text            [not null, note: 'CHECK in (above, below)']
  threshold_eur_mwh  "numeric(8,2)"  [not null, note: 'CHECK > 0 and <= 3000, the market price cap, so an extra zero is rejected']
  active             boolean         [not null, default: true]
  created_at         timestamptz     [not null, default: `now()`]
  updated_at         timestamptz     [not null, default: `now()`, note: 'maintained by a trigger, not by the application']

  Indexes {
    (created_by, created_at) [name: 'alerts_created_by_idx']
    active [name: 'alerts_active_idx', note: 'partial, WHERE active']
    (created_by, zone, direction, threshold_eur_mwh) [unique, note: 'a repeated request updates rather than duplicates']
  }

  Note: 'The manufacturer write action. The one table that exercises create, update and delete.'
}

Table iberian.episode_labels {
  id           bigserial    [pk]
  episode_key  text         [not null]
  created_by   text         [not null, note: 'CHECK length(trim()) > 0']
  true_cause   text         [not null, note: 'CHECK in (saturation_planned, saturation_unplanned, saturation_no_notice, saturation_ordinary_capacity, not_saturated, threshold_artifact, unclear)']
  confidence   text         [not null, note: 'CHECK in (high, medium, low)']
  notes        text
  created_at   timestamptz  [not null, default: `now()`]
  updated_at   timestamptz  [not null, default: `now()`, note: 'trigger']

  Indexes {
    episode_key [name: 'episode_labels_episode_idx']
    (created_by, created_at) [name: 'episode_labels_author_idx']
    (episode_key, created_by) [unique, note: 'one row per episode per author, so two people may disagree and both are kept']
  }

  Note: 'The evaluation ground truth, written through the agent. Flows back into Delta through the change data feed.'
}

Table iberian.agent_actions {
  id            bigserial    [pk]
  session_id    text         [not null]
  created_by    text
  tool          text         [not null]
  arguments     jsonb
  status        text         [not null, note: 'CHECK in (ok, rejected, error). rejected and error are separate states: a refused write is the system working, a failed one is not']
  detail        text         [note: 'shown to the user, so written in words rather than as a stack trace']
  target_table  text
  target_id     bigint
  latency_ms    integer      [note: 'CHECK >= 0']
  created_at    timestamptz  [not null, default: `now()`]

  Indexes {
    created_at [name: 'agent_actions_created_at_idx', note: 'DESC']
    (tool, status) [name: 'agent_actions_tool_idx']
    (session_id, created_at) [name: 'agent_actions_session_idx']
  }

  Note: 'One row per agent tool call. Append only, so no updated_at and no trigger.'
}

Ref: iberian.episode_labels.episode_key > iberian.episodes.episode_key [delete: cascade]
