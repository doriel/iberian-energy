# Copy to .env and fill in. .env is gitignored, never commit real values.

# ENTSO-E Transparency Platform, My Account -> generate token
ENTSOE_SECURITY_TOKEN=

# REE ESIOS. Personal token, requested by email. Do not share it.
ESIOS_TOKEN=

# Local stand in for the S3 bronze landing zone
RAW_DATA_DIR=data/raw

# Databricks workspace, for the CLI and the SDK.
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com

# The web app's OAuth credentials, from the app integration.
#
# Not DATABRICKS_CLIENT_ID and DATABRICKS_CLIENT_SECRET. Those names belong to
# the SDK and the CLI, which read them as a service principal to authenticate
# with, so setting them here makes every `databricks` command in this shell try
# to log in as the web app. These names keep the two apart.
# APP_OAUTH_CLIENT_ID=
# APP_OAUTH_CLIENT_SECRET=
# DATABRICKS_REDIRECT_URI=http://127.0.0.1:8000/callback
# DATABRICKS_SCOPES=postgres

# MLFLOW_TRACING_SQL_WAREHOUSE_ID=

# LAKEBASE_ENDPOINT_NAME=