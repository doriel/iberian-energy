# Copy to .env and fill in. .env is gitignored, never commit real values.
#
# Every value below is a placeholder with the right shape and the wrong
# content. Nothing here is a real host, account, identifier or secret, and
# nothing that is real should ever be written into this file: this one is
# committed to a public repository and the one you build from it is not.


# --- data sources -------------------------------------------------------------

# ENTSO-E Transparency Platform, My Account -> generate token
ENTSOE_SECURITY_TOKEN=

# REE ESIOS. Personal token, requested by email. Do not share it, and note
# REE's terms: anything published from it must be served from your own server.
ESIOS_TOKEN=

# Local stand in for the S3 bronze landing zone
RAW_DATA_DIR=data/raw


# --- Databricks workspace -----------------------------------------------------

# Read by the CLI and the SDK. Your own workspace URL, no trailing slash.
DATABRICKS_HOST=https://dbc-00000000-0000.cloud.databricks.com

# Which CLI profile the `databricks` command authenticates with. Worth setting
# when more than one profile points at the same host, because the CLI otherwise
# picks one and the wrong one fails with an error that does not mention profiles.
#
# DO NOT set this on a deployment. With a profile present the SDK preferred it
# over the service principal below: it generated a database credential for a
# person while connecting under the application's Postgres role name, and
# Lakebase refused with "OAuth: User is not authorized", which names neither.
# `src/iberian/app/workspace.py` now pins the identity so a profile cannot win,
# and this line stays commented so nobody has to rely on that.
# DATABRICKS_CONFIG_PROFILE=DEFAULT


# --- the application's own identity -------------------------------------------

# The service principal the app authenticates as, and the role it connects to
# Postgres with. These are the SDK's own reserved names and are the right ones
# here: this is the application acting as itself.
#
# Careful in a shell: any `databricks` command run after `source .env` will try
# to authenticate as this principal rather than as you. Use a clean terminal
# for the CLI.
#
# The secret is minted with
#   databricks service-principal-secrets-proxy create <numeric id>
# and the Postgres role is created by pipelines/00c_grant_service_principal.py.
DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000
DATABRICKS_CLIENT_SECRET=


# --- the Databricks sign in diagnostic ----------------------------------------

# /login and /callback only. Nothing in the application is behind them: the
# workbench asks a visitor for a name and reaches the database as the service
# principal above. Kept because they prove the OAuth integration works and are
# where to start if per person access is ever needed.
#
# From the workspace OAuth app integration.
#
# Deliberately NOT called DATABRICKS_CLIENT_ID and DATABRICKS_CLIENT_SECRET.
# Those names belong to the SDK and the CLI, which read them as a service
# principal to authenticate as, so setting them here makes every `databricks`
# command in this shell try to log in as the web app. These names keep the two
# apart.
APP_OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
APP_OAUTH_CLIENT_SECRET=

# Must match a redirect URL registered on the app integration exactly,
# including the scheme and any trailing slash. Locally this is 127.0.0.1;
# deployed it is the public URL of the service.
DATABRICKS_REDIRECT_URI=http://127.0.0.1:8000/callback

# all-apis, not postgres. The callback calls the workspace API to generate a
# database credential, and a token scoped only to Postgres cannot make that
# call. The token this buys is broad, which is why the callback spends it
# immediately and keeps only the database credential it produced.
DATABRICKS_SCOPES=all-apis


# --- Lakebase -----------------------------------------------------------------

# The endpoint's own host, NOT the -pooler one. The pooled host refuses the
# generated credential with "SASL authentication failed", with a cached and a
# fresh credential alike. Why was never established, so do not assume the
# pooler will work if traffic grows without testing it first.
LAKEBASE_HOST=ep-example-0000.database.us-west-2.cloud.databricks.com

# The Postgres role the connection opens as. The service principal's
# application id, the same value as DATABRICKS_CLIENT_ID above, because that is
# what its role is named. Read it from the output of
# pipelines/00c_grant_service_principal.py rather than assumed: for a user role
# the id and the role name differ.
LAKEBASE_USER=00000000-0000-0000-0000-000000000000

# Which endpoint a credential is generated for. No defaults in the code on
# purpose: a missing one fails at start up with the name rather than pointing
# at somebody else's project.
LAKEBASE_PROJECT=your-lakebase-project
LAKEBASE_BRANCH=production
LAKEBASE_ENDPOINT_ID=primary


# --- optional -----------------------------------------------------------------

# MLflow tracing needs a SQL warehouse to provision and query the Delta tables
# that hold the traces. `databricks warehouses list` shows the ones you can
# reach. A serverless starter warehouse stops itself when idle, and the first
# traced run after that waits for it to come back, so warm it before a demo.
# MLFLOW_TRACING_SQL_WAREHOUSE_ID=0123456789abcdef

# The serving endpoint the workbench agent calls. Only set this to override.
# AGENT_ENDPOINT=databricks-claude-haiku-4-5